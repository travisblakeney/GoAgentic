{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "ask",
    "edit": {
      "*": "ask",
      ".agents/**": "deny",
      ".claude/**": "deny",
      ".cursor/**": "deny",
      ".codex/**": "deny",
      ".gemini/**": "deny",
      ".opencode/**": "deny",
      ".pi/**": "deny",
      "opencode.json": "deny",
      ".git/**": "deny"
    },
    "bash": {
      "*": "ask",
      "date": "allow",
      "ls": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git push*": "deny",
      "git pull*": "deny",
      "git fetch*": "deny",
      "git remote*": "deny",
      "git clone*": "deny",
      "git submodule*": "deny",
      "gh *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "nc *": "deny",
      "npx *": "deny",
      "uvx *": "deny",
      "pipx *": "deny",
      "brew *": "deny",
      "sudo *": "deny",
      "launchctl *": "deny",
      "crontab *": "deny",
      "osascript *": "deny",
      "security *": "deny",
      "claude *": "deny",
      "codex *": "deny",
      "cursor-agent *": "deny",
      "gemini *": "deny",
      "opencode *": "deny",
      "pi *": "deny",
      "herdr *": "deny"
    }
  }
}
